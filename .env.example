# ==========================================
# Ashmawy Restaurant - Environment Configuration
# ==========================================

# Firebase Client SDK Configuration (Exposed to browser via Vite)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=ashmawy-ordering.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ashmawy-ordering
VITE_FIREBASE_STORAGE_BUCKET=ashmawy-ordering.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK Configuration (Server-side only for /api/orders/create)
# Option A: Service account JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option B: Individual credentials
FIREBASE_PROJECT_ID=ashmawy-ordering
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
